# Backend API (Django dev server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth — create credentials at https://console.cloud.google.com/
# Use the same Client ID as GOOGLE_OAUTH_CLIENT_ID in backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Must match the redirect URI in Google Cloud and GOOGLE_OAUTH_CALLBACK_URL in backend/.env
# Optional in dev: defaults to http://localhost:3000/auth/callback/google
NEXT_PUBLIC_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback/google

# --- Backend only (copy these into backend/.env, NOT into .env.local) ---
# AI Insights: OpenAI + Redis/Celery. Next.js never reads these.
# Full setup: backend/README.md#ai-insights-operator-setup
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# REDIS_URL=redis://127.0.0.1:6379/0
# AI_INSIGHTS_DAILY_LIMIT=5
