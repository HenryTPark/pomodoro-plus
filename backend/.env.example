# Copy to backend/.env and adjust as needed. Do NOT commit the real .env.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# Either set a full DATABASE_URL, or rely on the defaults below which match
# docker-compose.yml.
DATABASE_URL=postgres://pomodoro:pomodoro@localhost:5432/pomodoro

# Used by docker-compose.yml for the Postgres container.
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=pomodoro
POSTGRES_DB=pomodoro
POSTGRES_PORT=5432

# --- CORS / CSRF ----------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google OAuth (configured in a later phase) ---------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
