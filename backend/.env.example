# Django core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches docker-compose.yml defaults; local Postgres uses trust auth)
DATABASE_URL=postgres://pomodoro@localhost:5432/pomodoro

# CORS / CSRF (Next.js dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth (create credentials at https://console.cloud.google.com/)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI configured in Google Cloud and used by the frontend.
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback/google

# Redis (matches docker-compose.yml redis service; Celery broker + Django cache)
REDIS_URL=redis://127.0.0.1:6379/0

# OpenAI (AI productivity insights — Celery worker calls the API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max insight generations per user per calendar day (enforced in Postgres)
AI_INSIGHTS_DAILY_LIMIT=5
